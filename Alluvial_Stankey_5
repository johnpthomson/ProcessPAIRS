library(dplyr)
library(ggplot2)
library(ggalluvial)
library(stringr)
library(grid)


sankey_df <- hrd_status_wide %>%

  mutate(


    # Collapse BRCA context into BRCAm vs BRCAwt

    BRCA_status = case_when(

      BRCA_context %in% c(
        "1a.BRCA_germline",
        "1b.BRCA_shared_pre_post"
      ) ~ "BRCAm",

      BRCA_context %in% c(
        "2.BRCA_CN_altered_Pre",
        "3.No_BRCA_event"
      ) ~ "BRCAwt",

      TRUE ~ "Unknown"

    ),



    # PRA status

    PRA_status = case_when(

      PRA_high_confidence ~

        "PRA Present",

      TRUE ~

        "No PRA"

    ),



    # Count SNV resistance events
    # Only SECONDARY_REVERSION and SECONDARY_MUTATION

    SNV_events = case_when(

      is.na(resistance_report) ~

        0,

      TRUE ~

        str_count(
          resistance_report,
          "SECONDARY_REVERSION|SECONDARY_MUTATION"
        )

    ),



    # Collapse SNV resistance burden

    SNV_burden = case_when(

      SNV_events == 0 ~

        "0",

      SNV_events == 1 ~

        "1",

      SNV_events >= 2 ~

        "2+",

      TRUE ~

        "0"

    ),



    # Reclassify resistance mechanism

    resistance_headline = case_when(

      resistance_headline ==
        "No clear genomic resistance" &
        PRA_status == "PRA Present" ~

        "No clear Post event : PRA +ve",


      resistance_headline ==
        "No clear genomic resistance" ~

        "No clear Post event : PRA -ve",


      TRUE ~

        resistance_headline

    ),



    # Integrated SNV + CN resistance event burden

    Complexity = case_when(

      is.na(total_driver_events) ~

        "0",

      total_driver_events >= 5 ~

        "5+",

      total_driver_events >= 3 &
      total_driver_events <= 4 ~

        "3-4",

      total_driver_events >= 1 &
      total_driver_events <= 2 ~

        "1-2",

      TRUE ~

        "0"

    ),



    # Define plotting order

    BRCA_status = factor(

      BRCA_status,

      levels = c(
        "BRCAm",
        "BRCAwt",
        "Unknown"
      )

    ),



    PRA_status = factor(

      PRA_status,

      levels = c(
        "PRA Present",
        "No PRA"
      )

    ),



    SNV_burden = factor(

      SNV_burden,

      levels = c(
        "2+",
        "1",
        "0"
      )

    ),



    # Ensure highest integrated event burden appears first

    Complexity = factor(

      Complexity,

      levels = c(
        "5+",
        "3-4",
        "1-2",
        "0"
      )

    )

  ) %>%


  select(

    patient,
    BRCA_status,
    PRA_status,
    SNV_burden,
    Complexity,
    resistance_headline

  ) %>%


  distinct()



####################################
# Sankey plot
####################################


ggplot(

  sankey_df,

  aes(

    axis1 = BRCA_status,
    axis2 = PRA_status,
    axis3 = SNV_burden,
    axis4 = Complexity,
    axis5 = resistance_headline

  )

) +


  geom_alluvium(

    aes(fill = resistance_headline),

    width = 0.30,

    alpha = 0.8,

    colour = "grey40",

    linewidth = 0.10

  ) +


  geom_stratum(

    width = 0.30,

    fill = "grey95",

    colour = "black"

  ) +


  geom_text(

    stat = "stratum",

    aes(
      label = after_stat(stratum)
    ),

    size = 2.5

  ) +


  scale_x_discrete(

    limits = c(

      "BRCA Status",

      "PRA Status",

      "SNV resistance events",

      "SNV+CN resistance events",

      "Resistance Mechanism"

    ),

    expand = c(.05, .05)

  ) +


  theme_bw() +


  theme(

    legend.position = "bottom",

    legend.text = element_text(
      size = 7
    ),

    legend.title = element_text(
      size = 8
    ),

    legend.key.size = unit(
      0.3,
      "cm"
    ),

    legend.spacing.x = unit(
      0.05,
      "cm"
    ),

    axis.text.y = element_blank(),

    axis.ticks.y = element_blank()

  ) +


  labs(

    title =
      "Evolutionary trajectories of PARPi resistance",

    x = NULL,

    y = "Patients",

    fill =
      "Resistance mechanism"

  )
