# ======================================================
# PRA CORE TABLE (ROW-LEVEL ANNOTATION)
# ======================================================

pra_events <- hrd_long %>%

  filter(gene %in% PRA_gene_universe) %>%

  mutate(

    # --------------------------------------------------
    # PRE CN STATE
    # --------------------------------------------------

    pre_cn_event = case_when(
      cn_num_Pre < 2 ~ "CN_LOSS",
      cn_num_Pre > 2 ~ "CN_GAIN",
      TRUE ~ "CN_NEUTRAL"
    ),

    # --------------------------------------------------
    # CN EVENT
    # MUST MATCH EXPECTED RESISTANCE DIRECTION
    # --------------------------------------------------

    CN_event = case_when(

      cn_direction == "LOSS" &
        cn_num_Pre < 2 ~ TRUE,

      cn_direction == "GAIN" &
        cn_num_Pre > 2 ~ TRUE,

      TRUE ~ FALSE
    ),

    CN_event_label = case_when(

      cn_direction == "LOSS" &
        cn_num_Pre < 2 ~ "CN_LOSS",

      cn_direction == "GAIN" &
        cn_num_Pre > 2 ~ "CN_GAIN",

      TRUE ~ NA_character_
    ),

    # --------------------------------------------------
    # SNV EVENT
    # BRCA1/2 SNVs EXCLUDED
    # --------------------------------------------------

    SNV_event = case_when(

      gene %in% c("BRCA1", "BRCA2") ~ FALSE,

      snv_count_Pre > 0 &
        snv_axis %in% c(
          "POST_ACQUIRED_PATHOGENIC",
          "SECONDARY_REVERSION"
        ) ~ TRUE,

      TRUE ~ FALSE
    ),

    # --------------------------------------------------
    # UNIFIED EVENT TYPE
    # --------------------------------------------------

    PRA_event = case_when(

      CN_event & SNV_event ~ "CN+SNV",

      CN_event ~ "CN_EVENT",

      SNV_event ~ "SNV_EVENT",

      TRUE ~ NA_character_
    ),

    # --------------------------------------------------
    # SENTINEL FLAG
    # BRCA1/2 = CN ONLY
    # TP53BP1 = CN OR SNV OR CN+SNV
    # --------------------------------------------------

    PRA_sentinel = case_when(

      gene %in% c("BRCA1", "BRCA2") &
        CN_event ~ TRUE,

      gene == "TP53BP1" &
        (CN_event | SNV_event) ~ TRUE,

      TRUE ~ FALSE
    ),

    # --------------------------------------------------
    # EVENT STRING
    # --------------------------------------------------

    PRA_event_string = case_when(

      CN_event & SNV_event ~
        paste0(gene, " [CN+SNV]"),

      CN_event ~
        paste0(gene, " [", CN_event_label, "]"),

      SNV_event ~
        paste0(gene, " [SNV]"),

      TRUE ~ NA_character_
    )

  ) %>%

  filter(!is.na(PRA_event)) %>%

  ungroup()

# ======================================================
# HIGH-CONFIDENCE PRA
# ======================================================

pra_high_conf <- pra_events %>%

  group_by(patient) %>%

  summarise(

    # --------------------------------------------------
    # EVENT BURDEN
    # --------------------------------------------------

    PRA_event_burden =
      n(),

    # --------------------------------------------------
    # GENE DIVERSITY
    # --------------------------------------------------

    PRA_gene_diversity =
      n_distinct(gene),

    # --------------------------------------------------
    # SENTINEL PRESENCE
    # --------------------------------------------------

    PRA_sentinel_present =
      any(PRA_sentinel, na.rm = TRUE),

    # --------------------------------------------------
    # BRCA + TP53BP1 COEVENT
    # --------------------------------------------------

    BRCA_TP53BP1_coevent =

      any(
        gene %in% c("BRCA1", "BRCA2") &
          CN_event,
        na.rm = TRUE
      ) &

      any(
        gene == "TP53BP1" &
          (CN_event | SNV_event),
        na.rm = TRUE
      ),

    # --------------------------------------------------
    # TP53BP1 STANDALONE SENTINEL EVENT
    # --------------------------------------------------

    TP53BP1_sentinel_event =

      any(
        gene == "TP53BP1" &
          PRA_event %in% c(
            "CN_EVENT",
            "SNV_EVENT",
            "CN+SNV"
          ),
        na.rm = TRUE
      ),

    # --------------------------------------------------
    # HIGH CONFIDENCE CALL
    # --------------------------------------------------

    PRA_high_confidence =

      (
        PRA_sentinel_present &

        (
          PRA_event_burden >= 3 |

          PRA_gene_diversity >= 3 |

          BRCA_TP53BP1_coevent
        )
      ) |

      TP53BP1_sentinel_event,

    .groups = "drop"
  )

# ======================================================
# PATIENT SUMMARY
# ======================================================

pra_summary <- pra_events %>%

  group_by(patient) %>%

  summarise(

    PRA_events =
      paste(
        sort(unique(PRA_event_string)),
        collapse = "; "
      ),

    PRA_event_count =
      n(),

    PRA_gene_count =
      n_distinct(gene),

    PRA_sentinel_count =
      sum(PRA_sentinel, na.rm = TRUE),

    .groups = "drop"
  ) %>%

  mutate(

    Evidence_of_PRA =
      ifelse(
        PRA_event_count >= 1,
        "Y",
        "N"
      )
  )

# ======================================================
# MERGE INTO MAIN OUTPUT
# ======================================================

hrd_status_wide <- hrd_status_wide %>%

  left_join(
    pra_summary,
    by = "patient"
  ) %>%

  left_join(
    pra_high_conf,
    by = "patient"
  ) %>%

  mutate(

    Evidence_of_PRA =
      ifelse(is.na(Evidence_of_PRA), "N", Evidence_of_PRA),

    PRA_events =
      ifelse(is.na(PRA_events), ".", PRA_events),

    PRA_event_count =
      ifelse(is.na(PRA_event_count), 0, PRA_event_count),

    PRA_gene_count =
      ifelse(is.na(PRA_gene_count), 0, PRA_gene_count),

    PRA_sentinel_count =
      ifelse(is.na(PRA_sentinel_count), 0, PRA_sentinel_count),

    PRA_high_confidence =
      ifelse(is.na(PRA_high_confidence), FALSE, PRA_high_confidence)
  )

