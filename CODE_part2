library(dplyr)
library(stringr)

hrd_status_wide <- hrd_status_wide %>%
  mutate(

    # ==================================================
    # HEADLINE
    # ==================================================

    resistance_headline = case_when(

      final_classifier == "1.BRCA_associated_adaptive_restoration" &
        BRCA_orf_restore == "Y" ~
        "BRCA restoration",

      final_classifier == "1.BRCA_associated_adaptive_restoration" &
        BRCA_orf_restore == "N" ~
        "Acquired BRCA-associated adaptation",

      final_classifier == "2a.HR_bypass" ~
        "HR bypass",

      final_classifier == "2b.Fork_protection" ~
        "Fork protection",

      final_classifier == "2c.Drug_target_adaptation" ~
        "Drug target adaptation",

      final_classifier == "3.No_clear_genomic_resistance" ~
        "No clear genomic resistance",

      TRUE ~ NA_character_
    ),

    # ==================================================
    # JOURNEY COMPONENTS
    # ==================================================

    pra_component = case_when(

      PRA_high_confidence == TRUE ~
        "Pre-relapse adaptive resistance features were present",

      TRUE ~
        "Limited evidence of pre-relapse adaptive resistance"
    ),

    # --------------------------------------------------
    # Suppress mechanistic events for Class 3
    # --------------------------------------------------

    brca_component = case_when(

      final_classifier == "3.No_clear_genomic_resistance" ~
        NA_character_,

      str_detect(coalesce(resistance_report, ""), "SECONDARY_REVERSION") ~
        "followed by acquisition of a BRCA reversion event",

      str_detect(coalesce(resistance_report, ""), "SECONDARY_MUTATION") ~
        "followed by acquisition of a secondary BRCA mutation",

      str_detect(coalesce(resistance_report, ""), "BRCA_restoration") ~
        "followed by BRCA copy-number restoration",

      TRUE ~ NA_character_
    ),

    hr_component = case_when(

      final_classifier == "3.No_clear_genomic_resistance" ~
        NA_character_,

      str_detect(coalesce(mechanisms_involved, ""), "HR_bypass") ~
        "with concurrent HR bypass features",

      TRUE ~ NA_character_
    ),

    fork_component = case_when(

      final_classifier == "3.No_clear_genomic_resistance" ~
        NA_character_,

      str_detect(coalesce(mechanisms_involved, ""), "fork_protection") ~
        "with evidence of fork protection biology",

      TRUE ~ NA_character_
    ),

    parp_component = case_when(

      final_classifier == "3.No_clear_genomic_resistance" ~
        NA_character_,

      str_detect(coalesce(mechanisms_involved, ""), "drug_target_adaptation") ~
        "with evidence of PARP pathway adaptation",

      TRUE ~ NA_character_
    )
  ) %>%

  rowwise() %>%

  mutate(

    resistance_journey = paste(
      na.omit(c(
        pra_component,
        brca_component,
        hr_component,
        fork_component,
        parp_component
      )),
      collapse = " "
    ) %>%
      str_squish()

  ) %>%

  ungroup() %>%

  select(
    -pra_component,
    -brca_component,
    -hr_component,
    -fork_component,
    -parp_component
  )


