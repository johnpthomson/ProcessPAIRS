# ======================================================
# PRE CN GOI SUMMARY
# GOI CN events only
# ======================================================

goi_cn <- c(
  "BRCA1",
  "BRCA2",
  "TP53BP1",
  "CCNE1"
)

hrd_status_wide <- hrd_status_wide %>%

  rowwise() %>%

  mutate(

    PRE_CN_GOI_SUMMARY = {

      if (is.na(PRE_STATE) || PRE_STATE == ".") {

        "."

      } else {

        events <- strsplit(PRE_STATE, "; ")[[1]]

        cn_events <- events %>%

          .[str_detect(., "CN_GAIN|CN_LOSS")] %>%

          purrr::map_chr(function(x) {

            gene <- str_extract(x, "^[^:]+")

            cn <- str_extract(x, "CN_GAIN|CN_LOSS")

            paste0(gene, " [", cn, "]")

          })

        cn_events <- cn_events[
          str_extract(cn_events, "^[^ ]+") %in% goi_cn
        ]

        cn_events <- unique(cn_events)

        if (length(cn_events) == 0) {
          "."
        } else {
          paste(sort(cn_events), collapse = ", ")
        }
      }
    }

  ) %>%

  ungroup()

# ======================================================
# Extract BRCA CN change status (ROBUST VERSION)
# ======================================================

hrd_status_wide <- hrd_status_wide %>%
  mutate(

    # Extract full BRCA1/BRCA2 statements without cutting on semicolons
    brca_report =
      str_extract_all(
        resistance_report,
        "BRCA1:[^|]*?(?=\\s+[A-Z0-9]+:|$)|BRCA2:[^|]*?(?=\\s+[A-Z0-9]+:|$)"
      ),

    # Safely classify CNV signal across full extracted text
    BRCA_CN_change = case_when(

      map_lgl(brca_report, ~ any(str_detect(.x, "CN_GAIN"))) &
        map_lgl(brca_report, ~ any(str_detect(.x, "CN_LOSS"))) ~
        "MIXED",

      map_lgl(brca_report, ~ any(str_detect(.x, "CN_GAIN"))) ~
        "CN_GAIN",

      map_lgl(brca_report, ~ any(str_detect(.x, "CN_LOSS"))) ~
        "CN_LOSS",

      TRUE ~ "NONE"
    )

  ) %>%
  select(-brca_report)


# ======================================================
# Refine BRCA secondary event terminology
# Only TRUE ORF restorations retain
# "SECONDARY_REVERSION"
# ======================================================

hrd_status_wide <- hrd_status_wide %>%

  mutate(

    # --------------------------------------------------
    # Update main driver text
    # --------------------------------------------------

    main_driver = case_when(

      final_classifier == "1.BRCA_associated_adaptive_restoration" &
        BRCA_orf_restore == "N" ~
