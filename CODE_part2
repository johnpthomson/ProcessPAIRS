pre_gene_events <- hrd_long %>%

  # -----------------------------
  # Restrict to resistance genes
  # -----------------------------
  filter(gene %in% resistance_genes) %>%

  # -----------------------------
  # PRE signal extraction
  # -----------------------------
  mutate(

    pre_snv = snv_count_Pre,
    pre_cn  = cn_num_Pre,

    CN_event_pre = case_when(
      pre_cn > 2 ~ "CN_GAIN",
      pre_cn < 2 ~ "CN_LOSS",
