  mutate(

    pre_event_string = case_when(

      !is.na(CN_event_pre) & !is.na(SNV_event_pre) ~
        paste0(gene, ": ", classifier_group, " [", CN_event_pre, "; SNV]"),

      !is.na(CN_event_pre) ~
        paste0(gene, ": ", classifier_group, " [", CN_event_pre, "]"),

      !is.na(SNV_event_pre) ~
