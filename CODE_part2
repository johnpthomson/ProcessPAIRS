PRA_sentinel_genes <- c(
  "BRCA1", "BRCA2",
  "TP53BP1"
)

# ------------------------------------------------------
# DEFINE GENE UNIVERSE
# ------------------------------------------------------

if (!exists("PRA_gene_universe")) {

  PRA_gene_universe <- unique(
    hrd_long$gene
  )
