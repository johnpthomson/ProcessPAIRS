  "Unchanged",
  "Clonal_tracking_Unchanged"
)

plot_evolution(
  "Clonal expansion",
  "Clonal_tracking_Expansion"
)

plot_evolution(
  "Clonal shrinkage",
  "Clonal_tracking_Shrinkage"
)


