make_gene_summary <- function(
  panel_data,
  n_patients
) {

  if (
    n_patients == 0
  ) {

    return(
      tibble::tibble(
        gene =
          character(0),
        display_state =
          character(0),
        n =
          numeric(0),
        percent =
          numeric(0)
      )
    )

  }


  panel_data %>%

    count(

      gene,

      display_state,

      name =
        "n"

    ) %>%

    complete(

      gene =
        gene_order,

      display_state =
        names(event_colours),

      fill =
        list(
          n = 0
        )

    ) %>%

    filter(

      display_state !=
        "No event"

    ) %>%

    mutate(

      percent =
        100 * n /
        n_patients

    )

}


