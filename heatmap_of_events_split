############################################################
# 28. PANEL A FULL DATA FUNCTION
#
# IMPORTANT:
#   Build annotation rows explicitly.
#
#   This guarantees:
#     BRCA_context
#     PRA
#     Resistance
#
#   are actual rows in the plotting data and cannot be
#   dropped during a later join.
############################################################

make_panel_A_full <- function(
  panel_data,
  patient_order
) {

  annotation_data <-

    patient_architecture %>%

    filter(
      patient %in%
        patient_order
    ) %>%

    select(

      patient,

      PRA_status,

      BRCA_context_display,

      resistance_class

    ) %>%

    distinct(
      patient,
      .keep_all = TRUE
    )


  gene_data <-

    panel_data %>%

    mutate(

      panel_row =
        as.character(gene)

    ) %>%

    select(

      patient,

      panel_row,

      display_state

    )


  annotation_long <-

    tidyr::expand_grid(

      patient =
        patient_order,

      panel_row =

        c(

          "Resistance",

          "PRA",

          "BRCA_context"

        )

    ) %>%

    left_join(

      annotation_data,

      by =
        "patient"

    ) %>%

    mutate(

      display_state =

        case_when(

          panel_row ==
            "PRA" ~

            PRA_status,

          panel_row ==
            "BRCA_context" ~

            BRCA_context_display,

          panel_row ==
            "Resistance" ~

            case_when(

              resistance_class ==
                "BRCA associated" ~

                "BRCA assoc.",

              resistance_class ==
                "HR bypass" ~

                "HR bypass",

              resistance_class ==
                "Fork protection" ~

                "Fork prot.",

              resistance_class ==
                "Drug target" ~

                "Drug target",

              TRUE ~

                "No clear"

            ),

          TRUE ~

            NA_character_

        ),

      row_type =

        case_when(

          panel_row ==
            "Resistance" ~

            "Resistance",

          panel_row ==
            "PRA" ~

            "PRA",

          panel_row ==
            "BRCA_context" ~

            "BRCA_context",

          TRUE ~

            "Annotation"

        )

    ) %>%

    select(

      patient,

      panel_row,

      display_state,

      row_type

    )


  spacer_data <-

    tidyr::expand_grid(

      patient =
        patient_order,

      panel_row =
        c(
          "Spacer1",
          "Spacer2"
        )

    ) %>%

    mutate(

      display_state =
        NA_character_,

      row_type =
        "Spacer"

    )


  gene_data <-

    gene_data %>%

    mutate(

      row_type =
        "Gene"

    )


  bind_rows(

    gene_data,

    annotation_long,

    spacer_data

  ) %>%

    mutate(

      panel_row =
        factor(

          panel_row,

          levels =
            panel_A_row_order

        )

    ) %>%

    arrange(

      patient,

      panel_row

    )

}


