############################################################
# 56B. PRA CONSISTENCY CHECK
############################################################

pra_expected <-
  patient_architecture %>%

  select(
    patient,
    PRA_status
  ) %>%

  distinct()


pra_plotted <-
  bind_rows(

    panel_A_full_brca %>%

      filter(
        panel_row == "PRA"
      ) %>%

      select(
        patient,
        display_state
      ),

    panel_A_full_wt %>%

      filter(
        panel_row == "PRA"
      ) %>%

      select(
        patient,
        display_state
      )

  )


pra_check <-
  pra_expected %>%

  left_join(

    pra_plotted,

    by =
      "patient"

  ) %>%

  mutate(

    PRA_match =
      PRA_status ==
      display_state

  )


cat(
  "\nPRA expected vs plotted:\n"
)

print(
  pra_check,
  n = Inf
)


if (
  any(
    !pra_check$PRA_match,
    na.rm = TRUE
  )
) {

  warning(
    "PRA plotting mismatch detected."
  )

} else {

  cat(
    "\nPRA plotting check PASSED.\n"
  )

}


