    PRA_events
  ) %>%

  mutate(

    patient =
      as.character(patient),

    PRA_events =
      as.character(PRA_events)

  ) %>%

  filter(

    !is.na(PRA_events),

    PRA_events != ""

  ) %>%

  mutate(

    PRA_event =
      str_split(
        PRA_events,
        "\\s*;\\s*"
      )

  ) %>%

  tidyr::unnest(
    PRA_event
  ) %>%

  mutate(

    PRA_event =
      str_trim(
        PRA_event
      ),

    gene =
      toupper(
        str_trim(
          str_extract(
            PRA_event,
            "^[^\\[]+"
          )
        )
      ),

    cn_direction =
      case_when(

        str_detect(
          PRA_event,
          "\\[CN_GAIN\\]"
        ) ~
          "gain",

        str_detect(
          PRA_event,
          "\\[CN_LOSS\\]"
        ) ~
          "loss",

        TRUE ~
          NA_character_

      )

  ) %>%

  filter(

    !is.na(gene),

    gene != "",

    !is.na(cn_direction)

  ) %>%

  select(

    patient,

    gene,

    cn_direction

