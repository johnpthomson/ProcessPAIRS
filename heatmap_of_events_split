############################################################
# 32. SUMMARY BAR FUNCTION
#
# MAJOR FIX:
#
# The summary plot now uses EXACTLY the same
# panel_A_row_order as the heatmap.
#
# The annotation and spacer rows are included in the
# y-axis but contain zero-width/blank bars.
#
# Therefore the gene bars occupy precisely the same
# vertical coordinates as the gene tiles.
############################################################

make_summary_plot <- function(
  gene_summary,
  n_patients
) {

  if (
    n_patients == 0
  ) {

    summary_data <-
      tibble(

        panel_row =
          factor(
            panel_A_row_order,
            levels =
              panel_A_row_order
          ),

        percent =
          0,

        display_state =
          NA_character_

      )

  } else {

    summary_gene_data <-

      gene_summary %>%

      mutate(

        panel_row =
          as.character(gene)

      ) %>%

      select(

        panel_row,

        display_state,

        percent

      )


    ######################################################
    # Explicitly create every row in the SAME order as
    # the heatmap.
    ######################################################

    summary_data <-

      tidyr::expand_grid(

        panel_row =
          panel_A_row_order,

        display_state =
          names(event_colours)

      ) %>%

      left_join(

        summary_gene_data,

        by =
          c(
            "panel_row",
            "display_state"
          )

      ) %>%

      mutate(

        percent =
          replace_na(
            percent,
            0
          ),

        is_gene =
          panel_row %in%
          gene_order

      )

  }


  ggplot(

    summary_data,

    aes(

      x =
        percent,

      y =
        factor(
          panel_row,
          levels =
            panel_A_row_order
        ),

      fill =
        display_state

    )

  ) +

    geom_col(

      data =
        summary_data %>%

        filter(
          is_gene
        ),

      width =
        0.70,

      colour =
        "white",

      linewidth =
        0.2,

      position =
        "stack"

    ) +

    scale_fill_manual(

      values =
        event_colours,

      drop =
        TRUE,

      name =
        NULL

    ) +

    scale_x_reverse(

      limits =
        c(
          100,
          0
        ),

      breaks =
        c(
          100,
          75,
          50,
          25,
          0
        ),

      labels =
        function(x)
          paste0(
            x,
            "%"
          ),

      expand =
        c(
          0,
          0
        )

    ) +

    scale_y_discrete(

      limits =
        panel_A_row_order,

      drop =
        FALSE

    ) +

    labs(

      title =
        "Cohort",

      x =
        "% of patients",

      y =
        NULL

    ) +

    theme_minimal(

      base_size =
        9

    ) +

    theme(

      panel.grid.major.y =
        element_blank(),

      panel.grid.minor =
        element_blank(),

      axis.text.y =
        element_blank(),

      axis.ticks.y =
        element_blank(),

      axis.text.x =
        element_text(

          size =
            7

        ),

      axis.title.x =
        element_text(

          size =
            8

        ),

      plot.title =
        element_text(

          face =
            "bold",

          size =
            10

        ),

      legend.position =
        "none",

      plot.margin =
        margin(
          5,
          5,
          5,
          5
        )

    )

}


