make_panel_A_heatmap <- function(
  panel_data,
  patient_order,
  panel_title
) {

  panel_data <-
    panel_data %>%

    mutate(

      patient =
        factor(
          patient,
          levels =
            patient_order
        ),

      panel_row =
        factor(
          panel_row,
          levels =
            panel_A_row_order
        ),

      display_state =
        factor(
          display_state,
          levels =
            names(
              combined_colours
            )
        )

    )


  ggplot(

    panel_data,

    aes(

      x =
        patient,

      y =
        panel_row,

      fill =
        display_state

    )

  ) +

    geom_tile(

      colour =
        "white",

      linewidth =
        0.15

    ) +

    scale_fill_manual(

      values =
        combined_colours,

      drop =
        FALSE,

      na.value =
        "white",

      name =
        NULL

    ) +

    scale_x_discrete(

      limits =
        patient_order,

      position =
        "top",

      drop =
        FALSE

    ) +

    scale_y_discrete(

      limits =
        panel_A_row_order,

      drop =
        FALSE

    ) +

    labs(

      x =
        NULL,

      y =
        NULL,

      title =
        panel_title

    ) +

    theme_minimal(

      base_size =
        9

    ) +

    theme(

      panel.grid =
        element_blank(),

      axis.text.x =
        element_text(

          angle =
            90,

          vjust =
            0.5,

          hjust =
            0,

          size =
            6

        ),

      axis.text.y =
        element_text(

          size =
            8

        ),

      axis.ticks =
        element_blank(),

      legend.position =
        "bottom",

      legend.text =
        element_text(

          size =
            7

        ),

      plot.title =
        element_text(

          face =
            "bold",

          size =
            10

        ),

      plot.margin =
        margin(
          5,
          5,
          5,
          2
        )

    )

}


