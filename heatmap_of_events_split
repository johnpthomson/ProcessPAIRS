############################################################
# 15A. FUNCTION TO ORDER PATIENTS
############################################################

get_patient_order <- function(
  patients
) {

  if (
    length(patients) == 0
  ) {

    return(
      character(0)
    )

  }


  patients <-
    as.character(
      patients
    )


  patient_gene_order_data <-

    tidyr::expand_grid(

      patient =
        patients,

      gene =
        gene_order

    ) %>%

    left_join(

      hrd_fig3 %>%

        select(

          patient,

          gene,

          display_state

        ),

      by =
        c(
          "patient",
          "gene"
        )

    ) %>%

    mutate(

      ordering_rank =

        case_when(

          display_state %in%
            ordering_states ~

            unname(
              event_priority[
                display_state
              ]
            ),

          TRUE ~

            NA_real_

        )

    )


  patient_gene_order_data <-

    patient_gene_order_data %>%

    group_by(

      patient,

      gene

    ) %>%

    summarise(

      ordering_rank =

        if (
          all(
            is.na(
              ordering_rank
            )
          )
        ) {

          NA_real_

        } else {

          min(
            ordering_rank,
            na.rm =
              TRUE
          )

        },

      .groups =
        "drop"

    )


  patient_order_matrix <-

    patient_gene_order_data %>%

    tidyr::pivot_wider(

      names_from =
        gene,

      values_from =
        ordering_rank

    )


  for (
    g in gene_order
  ) {

    if (
      !g %in%
      colnames(
        patient_order_matrix
      )
    ) {

      patient_order_matrix[[g]] <-
        NA_real_

    }

  }


  patient_order_matrix <-

    patient_order_matrix %>%

    mutate(

      original_order =
        match(
          patient,
          patients
        )

    )


  for (
    g in gene_order
  ) {

    patient_order_matrix[[g]] <-

      ifelse(

        is.na(
          patient_order_matrix[[g]]
        ),

        99,

        patient_order_matrix[[g]]

      )

  }


  patient_order_matrix <-

    patient_order_matrix %>%

    arrange(

      !!!lapply(

        gene_order,

        function(g)
          rlang::sym(g)

      ),

      original_order

    )


  patient_order_matrix$patient

}


